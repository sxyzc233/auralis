# 统一换行，避免 Windows/Linux 差异造成整文件 diff
* text=auto eol=lf

# 源码
*.ets   text
*.ts    text
*.js    text
*.json  text
*.json5 text
*.cpp   text
*.h     text
*.md    text

# 二进制：不做换行转换；模型若改用 Git LFS 管理，去掉 lfs 注释即可
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.woff  binary
*.f32   binary
*.bin   binary
*.ms    binary
